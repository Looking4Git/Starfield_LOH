/* =========================================================================
   Starfield LOH – Gemeinsame Komponenten, Seiten, Tabellen & Dialoge (Common QSS)
   Strukturierte Single Source of Truth mit semantischen Design-Tokens
   ========================================================================= */


/* =========================================================================
   Abschnitt 1 – Basis & Typografie
   ========================================================================= */
QLabel {
    color: {{ TEXT_ON_DARK }};
    font-size: {{ FONT_SIZE_BASE }};
}

/* Universelle Inhaltstexte / Beschreibungen */
QLabel[variant="description"], QLabel#lbl_description, QLabel#lbl_reset_desc, QLabel#lbl_legal {
    color: {{ TEXT_ON_DARK }};
    font-size: {{ FONT_SIZE_DESC }};
    line-height: 1.4;
    margin-top: 0px;
    margin-bottom: 0px;
}

/* Teilüberschriften / Subheadings (Option A: 14px bold) */
QLabel[variant="subheading"], QLabel[variant="description_title"] {
    color: {{ TEXT_ON_DARK }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
    margin-top: 0px;
    margin-bottom: 0px;
}

QLabel[variant="muted"] {
    color: {{ TEXT_ON_DARK_MUTED }};
    font-size: 13px;
    line-height: 1.4;
    margin-top: 0px;
    margin-bottom: 0px;
}

/* Universelle Status-Meldungen unter Feldern */
QLabel[variant="status_success"] {
    color: {{ STATUS_SUCCESS }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
}

QLabel[variant="status_warning"] {
    color: {{ ACCENT_BRAND }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
}

QLabel[variant="status_critical"], QLabel[variant="status_error"] {
    color: {{ STATUS_CRITICAL }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
}

QLabel[variant="status_neutral"], QLabel[variant="status_info"] {
    color: {{ TEXT_ON_DARK_MUTED }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
}



/* =========================================================================
   Abschnitt 2 – Tabellen & Bäume (Master-View)
   ========================================================================= */
QTableView, QTreeView {
    background-color: {{ SURFACE_PRIMARY }};
    alternate-background-color: {{ SURFACE_SECONDARY }};
    color: {{ TEXT_ON_SURFACE }};
    gridline-color: {{ BORDER_TABLE }};
    border: none;
    outline: none;
    font-size: {{ FONT_SIZE_BASE }};
}

/* Universelle Zeilenhöhe und Padding für Bäume und Listen (z. B. Komponentenfeld auf Page_Mods) */
QTreeView::item, QListView::item {
    min-height: 28px;
    max-height: 28px;
    height: 28px;
    padding: 0px 4px;
}

/* Direkte Formatierung der Tabellenzellen bei Auswahl */
QTableView::item:selected, QListView::item:selected, QTreeView::item:selected,
QTableView::item:selected:active, QListView::item:selected:active, QTreeView::item:selected:active,
QTableView::item:selected:!active, QListView::item:selected:!active, QTreeView::item:selected:!active {
    background-color: {{ ACCENT_ACTION }};
    color: #ffffff;
}


/* Header im Dark Mode Design */
QHeaderView::section {
    background-color: {{ PANEL_HEADER }};
    color: {{ TEXT_ON_DARK }};
    padding: 6px;
    border: 1px solid {{ BORDER_DARK }};
    font-weight: bold;
    font-size: {{ FONT_SIZE_BASE }};
}

QHeaderView::section:horizontal:pressed {
    color: {{ ACCENT_BRAND }};
}

/* Markierung bei Spaltensortierung */
QHeaderView::up-arrow {
    image: url(Graphics/Icon_Arrow_Up.svg);
    width: 14px;
    height: 14px;
    padding-right: 5px;
}

QHeaderView::down-arrow {
    image: url(Graphics/Icon_Arrow_Down.svg);
    width: 14px;
    height: 14px;
    padding-right: 5px;
}

/* Tabellen Checkbox-Indikatoren */
QTableView::indicator, QTreeView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{ ACCENT_ACTION_HOVER }};
    background-color: #ffffff;
    border-radius: 0px;
}

QTableView::indicator:checked, QTreeView::indicator:checked {
    image: url(Graphics/Icon_Check.svg);
    background-color: {{ ACCENT_BRAND }};
    border: 1px solid {{ ACCENT_ACTION_HOVER }};
}

QTableView::indicator:unchecked, QTreeView::indicator:unchecked {
    image: none;
    background-color: #ffffff;
}

QTableView::indicator:selected, QTreeView::indicator:selected {
    border: 1px solid #ffffff;
}

QTableView::indicator:indeterminate, QTreeView::indicator:indeterminate {
    background-color: {{ STATUS_WARNING }};
    border: 1px solid {{ ACCENT_ACTION_HOVER }};
    image: url(Graphics/Icon_Check.svg);
}

QTableView::indicator:checked:disabled, QTreeView::indicator:checked:disabled {
    background-color: #B8BDC4;
    border: 1px solid {{ BORDER_SUBTLE }};
    image: url(Graphics/Icon_Check.svg);
}


/* =========================================================================
   Abschnitt 3 – Standard-Steuerelemente & Formulare (Inputs, Dropdowns, Checkboxen)
   ========================================================================= */

/* Text- und Eingabefelder */
QLineEdit, QTextEdit, QTextBrowser, QPlainTextEdit {
    background-color: {{ SURFACE_PRIMARY }};
    color: {{ TEXT_ON_SURFACE }};
    border: 1px solid {{ BORDER_INPUT }};
    padding: 4px 8px;
    border-radius: 2px;
    font-size: {{ FONT_SIZE_BASE }};
}

/* Komboboxen */
QComboBox {
    background-color: {{ SURFACE_PRIMARY }};
    color: {{ TEXT_ON_SURFACE }};
    border: 1px solid {{ BORDER_INPUT }};
    border-radius: 2px;
    padding: 4px 8px;
    font-size: {{ FONT_SIZE_BASE }};
}

QComboBox:disabled {
    background-color: {{ SURFACE_DISABLED }};
    color: {{ TEXT_MUTED }};
    border: 1px solid {{ BORDER_DARK }};
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 32px;
    background-color: {{ ACCENT_ACTION }};
    border: none;
}

QComboBox::drop-down:disabled {
    background-color: {{ SURFACE_DISABLED }};
}

QComboBox::drop-down:hover {
    background-color: {{ ACCENT_ACTION_HOVER }};
}

QComboBox::down-arrow {
    image: url(Graphics/Icon_Arrow_Down.svg);
    width: 14px;
    height: 14px;
    subcontrol-origin: content;
    subcontrol-position: center;
}

QComboBox QAbstractItemView {
    background-color: {{ SURFACE_PRIMARY }};
    color: {{ TEXT_ON_SURFACE }};
    selection-background-color: {{ SURFACE_SECONDARY }};
    selection-color: {{ TEXT_ON_SURFACE }};
    border: 1px solid {{ BORDER_INPUT }};
    padding: 2px 0px;
    outline: none;
    font-size: {{ FONT_SIZE_BASE }};
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 2px 8px;
    color: {{ TEXT_ON_SURFACE }};
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:selected:active,
QComboBox QAbstractItemView::item:selected:!active,
QComboBox QListView::item:selected,
QComboBox QListView::item:selected:active,
QComboBox QListView::item:selected:!active {
    background-color: {{ SURFACE_SECONDARY }};
    color: {{ TEXT_ON_SURFACE }};
}

QComboBox QAbstractItemView::item:hover,
QComboBox QListView::item:hover,
QComboBox QAbstractItemView::item:selected:hover,
QComboBox QListView::item:selected:hover {
    background-color: {{ ACCENT_ACTION_HOVER }};
    color: #ffffff;
}


/* Globale Checkboxen */
QCheckBox {
    color: {{ TEXT_ON_DARK }};
    font-size: {{ FONT_SIZE_BASE }};
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid {{ ACCENT_ACTION_HOVER }};
    border-radius: 0px;
}

QCheckBox::indicator:hover {
    border: 1px solid {{ ACCENT_BRAND }};
}

QCheckBox::indicator:checked {
    background-color: {{ ACCENT_BRAND }};
    image: url(Graphics/Icon_Check.svg);
    border: 1px solid {{ ACCENT_ACTION_HOVER }};
}

QCheckBox:disabled {
    color: {{ TEXT_MUTED }};
}

QCheckBox::indicator:disabled {
    background-color: {{ SURFACE_DISABLED }};
    border: 1px solid {{ BORDER_DARK }};
}


/* =========================================================================
   Abschnitt 4 – Buttons & Aktions-Schaltflächen
   ========================================================================= */
QPushButton {
    background-color: {{ BUTTON_BLUE_NORMAL }};
    color: {{ BUTTON_TEXT_NORMAL }};
    border: none;
    padding: 4px 8px;
    border-radius: 2px;
    font-size: {{ FONT_SIZE_BUTTON }};
    font-weight: bold;
    text-align: left;
}

QPushButton:hover {
    background-color: {{ BUTTON_BLUE_HOVER }};
}

QPushButton:pressed {
    background-color: {{ BUTTON_BLUE_PRESSED }};
}

QPushButton:disabled {
    background-color: {{ BUTTON_BLUE_DISABLED }};
    color: {{ BUTTON_TEXT_DISABLED }};
}

/* Textlabel in zusammengesetzten Premium-Buttons */
QLabel#btn_text {
    color: {{ BUTTON_TEXT_NORMAL }};
    font-size: {{ FONT_SIZE_BUTTON }};
    font-weight: bold;
    background: transparent;
    border: none;
    padding: 0px;
}

/* Spezifische Pfeiltasten */
QPushButton#btn_pos_up, QPushButton#btn_pos_down {
    padding: 0px;
    text-align: center;
}

/* Zoom-Button */
#btn_zoom {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0px;
    margin: 0px;
}

#btn_zoom:hover {
    background-color: rgba(215, 166, 75, 0.18);
    border: 1px solid {{ ACCENT_BRAND }};
}

#btn_zoom:pressed {
    background-color: rgba(215, 166, 75, 0.35);
    border: 1px solid {{ ACCENT_BRAND }};
}

/* Gefahrenbutton (Rot) */
QPushButton#btn_danger, QPushButton[variant="red"] {
    background-color: {{ BUTTON_RED_NORMAL }};
    color: {{ BUTTON_TEXT_NORMAL }};
    border: none;
    border-radius: 2px;
    min-height: 32px;
    max-height: 32px;
    padding: 4px 8px;
    text-align: left;
    font-size: {{ FONT_SIZE_BUTTON }};
    font-weight: bold;
}

QPushButton#btn_danger:hover, QPushButton[variant="red"]:hover {
    background-color: {{ BUTTON_RED_HOVER }};
}

QPushButton#btn_danger:pressed, QPushButton[variant="red"]:pressed {
    background-color: {{ BUTTON_RED_PRESSED }};
}

QPushButton#btn_danger:disabled, QPushButton[variant="red"]:disabled {
    background-color: {{ BUTTON_RED_DISABLED }};
    color: {{ BUTTON_TEXT_DISABLED }};
}

/* Grüner Aktionsbutton */
QPushButton#btn_success, QPushButton[variant="green"] {
    background-color: {{ BUTTON_GREEN_NORMAL }};
    color: {{ BUTTON_TEXT_NORMAL }};
    border: none;
    border-radius: 2px;
    min-height: 32px;
    max-height: 32px;
    padding: 4px 8px;
    text-align: left;
    font-size: {{ FONT_SIZE_BUTTON }};
    font-weight: bold;
}

QPushButton#btn_success:hover, QPushButton[variant="green"]:hover {
    background-color: {{ BUTTON_GREEN_HOVER }};
}

QPushButton#btn_success:pressed, QPushButton[variant="green"]:pressed {
    background-color: {{ BUTTON_GREEN_PRESSED }};
}

QPushButton#btn_success:disabled, QPushButton[variant="green"]:disabled {
    background-color: {{ BUTTON_GREEN_DISABLED }};
    color: {{ BUTTON_TEXT_DISABLED }};
}


/* =========================================================================
   Abschnitt 5 – Detail-Views & Layout-Komponenten
   ========================================================================= */

/* Detail-View Container */
#detail_view,
#scroll_area_detail,
#scroll_area_detail > QWidget {
    background-color: {{ WINDOW_BG }};
    border: none;
}

#detail_view QLabel#lbl_filter,
#detail_view QLabel#lbl_details,
#detail_view QLabel#lbl_sorter_section,
#detail_view QLabel#lbl_display_section,
#detail_view QLabel#lbl_install_process,
QLabel#lbl_filter,
QLabel#lbl_details,
QLabel#lbl_sorter_section,
QLabel#lbl_display_section,
QLabel#lbl_modules_section,
QLabel#lbl_tools_section,
QLabel#lbl_log_section,
QLabel#lbl_install_process,
#detail_view QLabel#lbl_assessment_stars {
    color: {{ TEXT_TITLE }};
    font-size: {{ FONT_SIZE_TITLE }};
    font-weight: bold;
}

QFrame#detail_separator,
QFrame#detail_separator_filter,
QFrame#sorter_separator,
QFrame#display_separator,
QFrame#sep_modules_section,
QFrame#sep_tools_section,
QFrame#sep_log_section,
QFrame#sep_install_process {
    background-color: {{ ACCENT_ACTION }};
    min-height: 4px;
    max-height: 4px;
    height: 4px;
    border: none;
}

#embedded_tree_frame {
    background-color: {{ SURFACE_PRIMARY }};
    border: 1px solid {{ BORDER_INPUT }};
    border-radius: 2px;
}

#embedded_tree_frame QTreeView, #detail_view QTreeView {
    border: none;
    background-color: {{ SURFACE_PRIMARY }};
    alternate-background-color: {{ SURFACE_SECONDARY }};
    color: {{ TEXT_ON_SURFACE }};
}

/* Spezifische Read-Only Markierungen */
#detail_view QLineEdit:read-only,
#Window_Mod_Statistics QLineEdit:read-only,
#Section_Mod_Statistics_Category QLineEdit:read-only,
#Page_Update #detail_view QLineEdit#inp_name_catalog,
#Page_Update #detail_view QLineEdit#inp_id_catalog,
#Page_Update #detail_view QLineEdit#inp_author,
#Page_Update #detail_view QLineEdit#inp_last_update_date,
#Page_Update #detail_view QLineEdit#inp_date_inst,
#Page_Update #detail_view QLineEdit#inp_date_avail,
#Page_Update #detail_view QLineEdit#inp_ver_inst,
#Page_Update #detail_view QLineEdit#inp_ver_avail {
    background-color: {{ SURFACE_READONLY }};
    color: {{ TEXT_READONLY }};
}

#Page_Update #detail_view QLineEdit:read-only,
#Page_Update #detail_view QTextEdit:read-only {
    background-color: {{ SURFACE_PRIMARY }};
    color: {{ TEXT_ON_SURFACE }};
}

#Window_Mod_Statistics QLabel,
QDockWidget QLabel,
#scroll_content QLabel {
    color: {{ TEXT_ON_DARK }}; 
}


/* =========================================================================
   Abschnitt 6 – Dialoge & Modale Fenster
   ========================================================================= */
QDialog, QMessageBox {
    background-color: {{ WINDOW_BG }};
    color: {{ TEXT_ON_DARK }};
}

QDialog QLabel, QMessageBox QLabel {
    color: {{ TEXT_ON_DARK }};
    font-size: {{ FONT_SIZE_BASE }};
}

QDialog QPushButton {
    background-color: {{ BUTTON_BLUE_NORMAL }};
    color: {{ BUTTON_TEXT_NORMAL }};
    border: none;
    padding: 4px 10px;
    border-radius: 2px;
    font-size: {{ FONT_SIZE_BUTTON }};
    font-weight: bold;
    min-width: 90px;
    min-height: 32px;
    max-height: 32px;
    text-align: left;
}

QMessageBox QPushButton {
    background-color: {{ BUTTON_BLUE_NORMAL }};
    color: {{ BUTTON_TEXT_NORMAL }};
    border: none;
    padding: 6px 16px;
    border-radius: 2px;
    font-size: {{ FONT_SIZE_BUTTON }};
    font-weight: bold;
    min-width: 90px;
    min-height: 32px;
    max-height: 32px;
    text-align: center;
}

QDialog QPushButton:hover, QMessageBox QPushButton:hover {
    background-color: {{ BUTTON_BLUE_HOVER }};
}

QDialog QPushButton:pressed, QMessageBox QPushButton:pressed {
    background-color: {{ BUTTON_BLUE_PRESSED }};
}

QDialog QPushButton[variant="red"], QDialog QPushButton#btn_danger {
    background-color: {{ BUTTON_RED_NORMAL }};
    color: {{ BUTTON_TEXT_NORMAL }};
}

QDialog QPushButton[variant="red"]:hover, QDialog QPushButton#btn_danger:hover {
    background-color: {{ BUTTON_RED_HOVER }};
}

QDialog QPushButton[variant="red"]:pressed, QDialog QPushButton#btn_danger:pressed {
    background-color: {{ BUTTON_RED_PRESSED }};
}

QLabel#lbl_dialog_title {
    color: {{ TEXT_TITLE }};
    font-size: 16px;
    font-weight: bold;
    margin: 0px;
    padding: 0px;
}

QDialog QLineEdit, QDialog QTextEdit, QDialog QPlainTextEdit, QDialog QTextBrowser {
    background-color: {{ SURFACE_PRIMARY }};
    color: {{ TEXT_ON_SURFACE }};
    border: 1px solid {{ BORDER_INPUT }};
    border-radius: 2px;
    font-size: {{ FONT_SIZE_BASE }};
}


/* =========================================================================
   Abschnitt 7 – Rollbalken (Dark Mode Scrollbars)
   ========================================================================= */

/* Vertikale Scrollbar */
QScrollBar:vertical {
    border: none;
    background: {{ SCROLLBAR_TRACK }};
    width: 16px;
    margin: 16px 0px 16px 0px;
}

QTableView QScrollBar:vertical, QTreeView QScrollBar:vertical {
    background: {{ SCROLLBAR_TRACK }};
}

QScrollBar::handle:vertical {
    background: {{ SCROLLBAR_HANDLE }};
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: {{ SCROLLBAR_HANDLE_HOVER }};
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: {{ SCROLLBAR_TRACK }};
    border: none;
}

QScrollBar::sub-line:vertical {
    background: {{ SCROLLBAR_TRACK }};
    border: none;
    height: 16px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow:vertical {
    background: {{ SCROLLBAR_HANDLE }};
    border-radius: 4px;
    margin: 2px;
    image: none;
}

QScrollBar::up-arrow:vertical:hover {
    background: {{ SCROLLBAR_HANDLE_HOVER }};
}

QScrollBar::add-line:vertical {
    background: {{ SCROLLBAR_TRACK }};
    border: none;
    height: 16px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::down-arrow:vertical {
    background: {{ SCROLLBAR_HANDLE }};
    border-radius: 4px;
    margin: 2px;
    image: none;
}

QScrollBar::down-arrow:vertical:hover {
    background: {{ SCROLLBAR_HANDLE_HOVER }};
}

/* Horizontale Scrollbar */
QScrollBar:horizontal {
    border: none;
    background: {{ SCROLLBAR_TRACK }};
    height: 16px;
    min-height: 16px;
    max-height: 16px;
    margin: 0px 16px 0px 16px;
}

QScrollBar::handle:horizontal {
    background: {{ SCROLLBAR_HANDLE }};
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: {{ SCROLLBAR_HANDLE_HOVER }};
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: {{ SCROLLBAR_TRACK }};
    border: none;
}

QScrollBar::sub-line:horizontal {
    background: {{ SCROLLBAR_TRACK }};
    border: none;
    width: 16px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::left-arrow:horizontal {
    background: {{ SCROLLBAR_HANDLE }};
    border-radius: 4px;
    margin: 2px;
    image: none;
}

QScrollBar::left-arrow:horizontal:hover {
    background: {{ SCROLLBAR_HANDLE_HOVER }};
}

QScrollBar::add-line:horizontal {
    background: {{ SCROLLBAR_TRACK }};
    border: none;
    width: 16px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::right-arrow:horizontal {
    background: {{ SCROLLBAR_HANDLE }};
    border-radius: 4px;
    margin: 2px;
    image: none;
}

QScrollBar::right-arrow:horizontal:hover {
    background: {{ SCROLLBAR_HANDLE_HOVER }};
}

/* Eck-Verbindungsstück zwischen horizontalem und vertikalem Rollbalken */
QTableView::corner, QTreeView::corner, QAbstractScrollArea::corner {
    background: {{ SCROLLBAR_TRACK }};
    border: none;
}

/* Weichzeichnung bei Nichtbedarf (needed="false") */
QScrollBar:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}
QScrollBar::sub-line:vertical[needed="false"],
QScrollBar::add-line:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
    border: none;
}
QScrollBar::up-arrow:vertical[needed="false"],
QScrollBar::down-arrow:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}
QScrollBar::add-page:vertical[needed="false"],
QScrollBar::sub-page:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}
QScrollBar::handle:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}


/* =========================================================================
   Abschnitt 8 – Seiten-Spezifische Ergänzungen (Page_Settings, Page_LoadOrder)
   ========================================================================= */
#Page_Settings QLabel#lbl_setting_title {
    color: {{ TEXT_ON_DARK }};
    font-size: 20px;
    font-weight: bold;
    margin: 0px;
    padding: 0px;
}

#Page_Settings #detail_view QLineEdit {
    font-size: {{ FONT_SIZE_BASE }};
}

#Page_Settings #detail_view QLineEdit:read-only {
    background-color: {{ SURFACE_READONLY }};
    color: #000000;
    font-size: {{ FONT_SIZE_BASE }};
}

#Page_Settings QTreeView#settings_tree {
    background-color: {{ PANEL_BG }};
    alternate-background-color: {{ PANEL_BG }};
    color: {{ TEXT_ON_DARK }};
    border: none;
    border-right: 1px solid {{ BORDER_SUBTLE }};
    outline: none;
    font-size: {{ FONT_SIZE_BASE }};
    padding: 6px 0px;
}

#Page_Settings QTreeView#settings_tree::branch {
    background: transparent;
}

#Page_Settings QTreeView#settings_tree::item {
    min-height: 42px;
    max-height: 42px;
    height: 42px;
    padding-left: 10px;
    margin-top: 3px;
    margin-bottom: 3px;
    color: {{ TEXT_ON_DARK_MUTED }};
    border: none;
}

#Page_Settings QTreeView#settings_tree::item:hover {
    background-color: {{ BORDER_SUBTLE }};
}

#Page_Settings QTreeView#settings_tree::item:selected,
#Page_Settings QTreeView#settings_tree::item:selected:active,
#Page_Settings QTreeView#settings_tree::item:selected:!active {
    background-color: {{ ACCENT_ACTION }};
    color: {{ TEXT_ON_ACTION_BUTTON }};
    font-weight: bold;
}

#Page_Settings QPushButton#btn_browse,
#Page_Settings QPushButton#btn_browse_data,
#Page_Settings QPushButton#btn_reset_data_path,
#Page_Settings QPushButton#btn_reauthorize_system,
#Page_Settings QPushButton#btn_toggle_api_key {
    padding: 0px;
    text-align: center;
}

#tree_profile::item {
    height: 28px;
    padding: 0px 4px;
}

/* Limit-Balken Beschriftungen */
#lbl_full_val,
#lbl_medium_val,
#lbl_small_val,
#lbl_pointers_val {
    color: {{ TEXT_ON_DARK_MUTED }};
    font-size: 12px;
    margin-bottom: 0px;
}

/* Hauptseitentitel (z. B. Page_Tools) */
QLabel#lbl_page_title {
    color: {{ TEXT_ON_DARK }};
    font-size: 22px;
    font-weight: bold;
    margin: 0px;
    padding: 0px;
}

/* Protokoll- und Konsolen-Widget (Widget_LogConsole & Log-Viewer) */
Widget_LogConsole, QPlainTextEdit#log_console, QPlainTextEdit#txt_log_content {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 13px;
    line-height: 1.4;
    padding: 10px;
    border: 1px solid #333333;
    border-radius: 4px;
}

/* Dashboard-Modul-Kacheln (Widget_TileIconButton) */
QLabel#tile_text {
    color: {{ TILE_TEXT_COLOR }};
    font-size: {{ TILE_TEXT_SIZE }};
    font-family: "Segoe UI", Arial, sans-serif;
    background: transparent;
    border: none;
    padding: 0px;
}

QLabel#tile_text:disabled {
    color: {{ TILE_TEXT_DISABLED }};
}

/* =========================================================================
   Abschnitt 13 – Haupt-Splitter & Begleitpanel (Dock & Floating)
   ========================================================================= */
QSplitter#main_splitter::handle {
    background-color: {{ WINDOW_BG }};
}

QWidget#dock_container,
QWidget#FloatingCompanionWindow {
    background-color: {{ WINDOW_BG }};
}

QWidget#dock_header {
    background-color: {{ WINDOW_BG }};
    border-bottom: 1px solid {{ BORDER_SUBTLE }};
    min-height: 38px;
    max-height: 38px;
}

QLabel#lbl_dock_title {
    color: {{ TEXT_ON_DARK_MUTED }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
    font-family: {{ FONT_FAMILY }};
}

QPushButton#btn_dock_float,
QPushButton#btn_dock_close {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: {{ TEXT_ON_DARK_MUTED }};
    font-size: 14px;
    font-weight: bold;
}

QPushButton#btn_dock_float:hover {
    background-color: {{ BUTTON_BLUE_HOVER }};
    color: {{ ACCENT_BRAND }};
}

QPushButton#btn_dock_close:hover {
    background-color: {{ STATUS_CRITICAL }};
    color: #ffffff;
}

QWidget#floating_dock_header {
    background-color: {{ WINDOW_BG }};
    border-bottom: 1px solid {{ BORDER_SUBTLE }};
    min-height: 38px;
    max-height: 38px;
}

QLabel#lbl_floating_title {
    color: {{ TEXT_ON_DARK_MUTED }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
    font-family: {{ FONT_FAMILY }};
}

QPushButton#btn_floating_redock {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: {{ TEXT_ON_DARK_MUTED }};
    font-size: 14px;
    font-weight: bold;
}

QPushButton#btn_floating_redock:hover {
    background-color: {{ BUTTON_BLUE_HOVER }};
    color: {{ ACCENT_BRAND }};
}

/* =========================================================================
   Abschnitt 13 – Tooltips (HUD-Design)
   ========================================================================= */
QToolTip {
    background-color: {{ SURFACE_SECONDARY }};
    color: {{ TEXT_ON_SURFACE }};
    border: 1px solid {{ ACCENT_ACTION }};
    padding: 2px 4px;
    font-family: {{ FONT_FAMILY }};
    font-size: {{ FONT_SIZE_DESC }};
}

/* Spezifischer HUD-Tooltip fuer Inhalts-Diagramme */
Widget_ContentRadarChart QToolTip,
Widget_ContentBarChart QToolTip {
    background-color: {{ CHART_TOOLTIP_BG }};
    color: {{ CHART_TOOLTIP_TEXT }};
    border: 1px solid {{ ACCENT_ACTION }};
    padding: 2px 4px;
}