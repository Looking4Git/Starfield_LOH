/* =========================================================
   Starfield LOH – Hauptfenster & Navigation (Main QSS)
   ========================================================= */

/* Hauptfenster Hintergrund */
QMainWindow, QStackedWidget#content_area {
    background-color: {{ WINDOW_BG }};
    color: {{ TEXT_ON_DARK }};
}

/* Sidebar Bereich */
QFrame#sidebar {
    background-color: {{ PANEL_BG }};
    border-right: 1px solid {{ BORDER_SUBTLE }};
}

/* Unsere Custom Menü-Buttons */
QPushButton#menu_button {
    background-color: transparent;
    color: {{ TEXT_ON_DARK_MUTED }};
    border: none;
    font-size: 16px;
    font-family: {{ FONT_FAMILY }};

    /* --- ZENTRALE DEFINITION DER ABSTÄNDE --- */
    qproperty-padding_left: 16;
    qproperty-spacing_text: 16; 
}

QPushButton#menu_button QLabel {
    background: transparent;
    color: {{ TEXT_ON_DARK_MUTED }};
}

QPushButton#menu_button:hover {
    background-color: {{ BORDER_SUBTLE }};
    color: white;
}

QLabel {
    color: {{ TEXT_ON_DARK_MUTED }};
}

/* Aktiver Menü-Button */
QPushButton#menu_button[active="true"] {
    background-color: {{ ACCENT_ACTION }};
}

QPushButton#menu_button[active="true"] QLabel {
    color: {{ TEXT_ON_DARK }};
}

/* Trennkante zwischen Hauptfenster und angedockten Fenstern */
QMainWindow::separator {
    background-color: {{ BORDER_DARK }};
    width: 4px;
    margin: 0px;
    padding: 0px;
}

QMainWindow::separator:hover {
    background-color: {{ ACCENT_ACTION }};
}