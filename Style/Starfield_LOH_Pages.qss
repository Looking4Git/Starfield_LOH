/* =========================================================
   Generelle Tabellen (Master-View)
   ========================================================= */
QTableView, QTreeView {
    background-color: #ECECEC; /* Heller Hintergrund nach Vorgabe [cite: 1, 2] */
    alternate-background-color: #F2F2F2;
    color: #1e1e1e;
    gridline-color: #d0d0d0;
    border: none;
    outline: none; /* Entfernt den Fokus-Rahmen um Text  */
}

/* Direkte Formatierung der Tabellenzellen bei Auswahl */
QTableView::item:selected, QListView::item:selected, QTreeView::item:selected {
    background-color: #304C7A; /* Starfield Blau  */
    color: #ffffff;            /* Weißer Text bei Selektion  */
}

/* Optional: Korrektur für den Fokus-Zustand, damit Blau erhalten bleibt */
QTableView::item:selected:active, QListView::item:selected:active, QTreeView::item:selected:active {
    background-color: #304C7A;
}

QTableView::item:selected:!active, QListView::item:selected:!active, QTreeView::item:selected:!active {
    background-color: #304C7A;
    color: #ffffff;
}

/* Header im Dark Mode Design */
QHeaderView::section {
    background-color: #2b2b2b;
    color: #ECECEC; /* Starfield Weiß */
    padding: 6px;
    border: 1px solid #1a1a1a;
    font-weight: bold;
}

/* Markierung bei Spaltensortierung */
QHeaderView::up-arrow {
    image: url(Graphics/Icon_Arrow_Up.svg);
    width: 14px; height: 14px;
    padding-right: 5px;
}

QHeaderView::down-arrow {
    image: url(Graphics/Icon_Arrow_Down.svg);
    width: 14px; height: 14px;
    padding-right: 5px;
}

QHeaderView::section:horizontal:pressed {
    color: #D7A64B; /* Starfield Gelb beim Klicken */
}


/* =========================================================
   Scrollbars (Dark Mode Style)
   ========================================================= */
/* Vertikale Scrollbar */
QScrollBar:vertical {
    border: none;
    background: #2b2b2b;
    width: 16px;
    margin: 16px 0px 16px 0px;
}

QTableView QScrollBar:vertical, QTreeView QScrollBar:vertical {
    background: #2b2b2b; /* Fester Hintergrund für Tabellen, da deren Scrollbars bei Nichtbedarf ohnehin komplett verschwinden */
}

QScrollBar::handle:vertical {
    background: #304C7A;
    min-height: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #5b7a9e;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: #2b2b2b;
    border: none;
}

QScrollBar::sub-line:vertical {
    background: #2b2b2b; /* Square dark container perfectly covers corners */
    border: none;
    height: 16px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::up-arrow:vertical {
    background: #304C7A; /* Rounded inner button */
    border-radius: 4px;
    margin: 2px;
    image: none; /* Verhindert das Standard-Pfeilsymbol */
}

QScrollBar::up-arrow:vertical:hover {
    background: #5b7a9e;
}

QScrollBar::add-line:vertical {
    background: #2b2b2b; /* Square dark container */
    border: none;
    height: 16px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

QScrollBar::down-arrow:vertical {
    background: #304C7A;
    border-radius: 4px;
    margin: 2px;
    image: none;
}

QScrollBar::down-arrow:vertical:hover {
    background: #5b7a9e;
}

/* Horizontale Scrollbar */
QScrollBar:horizontal {
    border: none;
    background: #2b2b2b;
    height: 16px;
    min-height: 16px;
    max-height: 16px;
    margin: 0px 16px 0px 16px;
}

QScrollBar::handle:horizontal {
    background: #304C7A;
    min-width: 20px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #5b7a9e;
}

QScrollBar::sub-line:horizontal {
    background: #2b2b2b; /* Square dark container */
    border: none;
    width: 16px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}

QScrollBar::left-arrow:horizontal {
    background: #304C7A;
    border-radius: 4px;
    margin: 2px;
    image: none;
}

QScrollBar::left-arrow:horizontal:hover {
    background: #5b7a9e;
}

QScrollBar::add-line:horizontal {
    background: #2b2b2b; /* Square dark container */
    border: none;
    width: 16px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}

QScrollBar::right-arrow:horizontal {
    background: #304C7A;
    border-radius: 4px;
    margin: 2px;
    image: none;
}

QScrollBar::right-arrow:horizontal:hover {
    background: #5b7a9e;
}

QTableView::corner, QTreeView::corner, QAbstractScrollArea::corner {
    background: #2b2b2b;
    border: none;
}

/* =========================================================
   Detail-View Container
   ========================================================= */
#detail_view,
#scroll_area_detail,
#scroll_area_detail > QWidget {
    background-color: transparent;
}

#detail_view QLabel,
#Window_Mod_Statistics QLabel,
QDockWidget QLabel,
#scroll_content QLabel {
    color: #ECECEC; 
}

/* =========================================================
   Überschriften und Trennlinien im Detail-View (NEU)
   ========================================================= */
#detail_view QLabel#lbl_filter,
#detail_view QLabel#lbl_details,
#detail_view QLabel#lbl_sorter_section,
#detail_view QLabel#lbl_display_section,
QLabel#lbl_filter,
QLabel#lbl_details,
QLabel#lbl_sorter_section,
QLabel#lbl_display_section,
QLabel#lbl_modules_section,
QLabel#lbl_tools_section {
    color: #D7A64B; /* Starfield Gelb als Akzentfarbe für Überschriften */
    font-size: 16px;
    font-weight: bold;
    margin-top: 4px;
    margin-bottom: 2px;
}

QFrame#detail_separator,
QFrame#sorter_separator,
QFrame#display_separator,
QFrame#sep_modules_section,
QFrame#sep_tools_section {
    background-color: #304C7A;
    min-height: 4px;
    max-height: 4px;
    height: 4px;
    border: none;
}

/* Checkboxen im Detail-View */
#detail_view QCheckBox,
QCheckBox#chk_sorter_show_columns {
    color: #ECECEC;
    font-size: 13px;
    spacing: 8px;
    background: transparent;
}

#detail_view QCheckBox::indicator,
QCheckBox#chk_sorter_show_columns::indicator {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
    border: 1px solid #5b7a9e;
    border-radius: 0px;
}

#detail_view QCheckBox::indicator:hover,
QCheckBox#chk_sorter_show_columns::indicator:hover {
    border: 1px solid #D7A64B;
}

#detail_view QCheckBox::indicator:checked,
QCheckBox#chk_sorter_show_columns::indicator:checked {
    background-color: #D7A64B;
    image: url(Graphics/Icon_Check.svg);
    border: 1px solid #5b7a9e;
}

#lbl_components_label, #lbl_creation_categories_label, #lbl_requirements_label, #lbl_dependencies_label {
    margin: 6px 0px 0px 0px;
    padding: 0px;
    border: none;
}

/* =========================================================
   Eingabefelder im Detail-View
   ========================================================= */
#detail_view QLineEdit, 
#detail_view QComboBox,
#detail_view QTextEdit,
#detail_view QListView {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #888888;
    padding: 4px 8px;
    border-radius: 2px;
}

#detail_view QTreeView {
    border: none;
}

#detail_view QLineEdit:read-only,
#Window_Mod_Statistics QLineEdit:read-only,
#Section_Mod_Statistics_Category QLineEdit:read-only {
    background-color: #D7A64B; 
    color: #000000;
}

#Page_Update #detail_view QLineEdit:read-only,
#Page_Update #detail_view QTextEdit:read-only {
    background-color: #ffffff;
    color: #000000;
}

#Page_Update #detail_view QLineEdit#inp_name_catalog,
#Page_Update #detail_view QLineEdit#inp_id_catalog {
    background-color: #D7A64B; 
    color: #000000;
}

/* =========================================================
   Komboboxen im Detail-View
   ========================================================= */
QComboBox {
    border: 1px solid #888888;
    border-radius: 2px;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 32px;
    background-color: #304C7A;
    border: none;
}

QComboBox::down-arrow {
    image: url(Graphics/Icon_Arrow_Down.svg);
    width: 14px;
    height: 14px;
    subcontrol-origin: content;
    subcontrol-position: center;
}

QComboBox::drop-down:hover {
    background-color: #5b7a9e;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #304C7A;
    selection-color: #ECECEC;
    border: 1px solid #888888;
    padding: 2px 0px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 2px 8px;
    color: #000000;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #304C7A;
    color: #ECECEC;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #5b7a9e;
    color: #FFFFFF;
}

/* =========================================================
   Assessment Sterne
   ========================================================= */
#detail_view QLabel#lbl_assessment_stars {
    color: #D7A64B;
    font-size: 16px;
}

/* =========================================================
   Buttons in Pages
   ========================================================= */
QPushButton {
    background-color: #304C7A;
    color: #ECECEC;
    border: none;
    padding: 4px 8px 4px 8px; /* Symmetrisches Padding */
    border-radius: 2px;
    text-align: left; /* Linksbündig ausrichten, damit alle Icons unabhängig von der Textlänge auf gleicher Höhe liegen */
}

QPushButton:hover {
    background-color: #5b7a9e;
}

QPushButton:pressed {
    background-color: #1F3354;
}

QPushButton:disabled {
    background-color: #222D3D;
    color: #888888;
}

/* Spezifische Styles für Pfeiltasten zur perfekten Zentrierung und korrekten Höhe */
QPushButton#btn_pos_up, QPushButton#btn_pos_down {
    padding: 0px;
    text-align: center;
}


/* =========================================================
   Unsichtbarer Rollbalken (wenn nicht benötigt, aber reserviert)
   ========================================================= */
QScrollBar:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}
QScrollBar::sub-line:vertical[needed="false"],
QScrollBar::add-line:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
    border: none;
}
QScrollBar::up-arrow:vertical[needed="false"],
QScrollBar::down-arrow:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}
QScrollBar::add-page:vertical[needed="false"],
QScrollBar::sub-page:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}
QScrollBar::handle:vertical[needed="false"] {
    background-color: transparent;
    background: transparent;
}

/* =========================================================
   Dialoge und MessageBoxen (Dark Mode)
   ========================================================= */
QDialog, QMessageBox {
    background-color: rgb(13, 13, 13);
    color: #ECECEC;
}

QDialog QLabel, QMessageBox QLabel {
    color: #ECECEC;
    font-size: 13px;
}

/* Sicherstellen, dass Buttons in QMessageBoxen dem Design entsprechen */
QDialog QPushButton, QMessageBox QPushButton {
    background-color: #304C7A;
    color: #ECECEC;
    border: none;
    padding: 6px 16px;
    border-radius: 2px;
    font-size: 13px;
    min-width: 75px;
}

QDialog QPushButton:hover, QMessageBox QPushButton:hover {
    background-color: #5b7a9e;
}

/* =========================================================
   Tabellen Checkbox-Indikatoren (High Contrast & Custom Checkmark)
   ========================================================= */
QTableView::indicator, QTreeView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #5b7a9e;
    background-color: #ffffff;
    border-radius: 0px;
}

/* Wenn markiert, blenden wir unser schönes Starfield-Blaues SVG ein */
QTableView::indicator:checked, QTreeView::indicator:checked {
    image: url(Graphics/Icon_Check.svg);
    background-color: #D7A64B;
    border: 1px solid #5b7a9e;
}

/* Wenn unmarkiert, stellen wir sicher, dass es ein leerer weißer Kasten bleibt */
QTableView::indicator:unchecked, QTreeView::indicator:unchecked {
    image: none;
    background-color: #ffffff;
}

/* Selektions-Status: Etwas kräftigerer Rahmen bei ausgewählter Zeile */
QTableView::indicator:selected, QTreeView::indicator:selected {
    border: 1px solid #ffffff;
}

/* Checkbox Typ 0 im Konfliktbereich (LOH Tabellen-Standard) */
QCheckBox#chk_show_type_0 {
    color: #ECECEC;
    font-family: "Segoe UI", Arial;
    font-size: 13px;
    spacing: 8px;
    background: transparent;
}
QCheckBox#chk_show_type_0::indicator {
    width: 14px;
    height: 14px;
    background-color: #ffffff;
    border: 1px solid #5b7a9e;
    border-radius: 0px;
}
QCheckBox#chk_show_type_0::indicator:hover {
    border: 1px solid #D7A64B;
}
QCheckBox#chk_show_type_0::indicator:checked {
    background-color: #D7A64B;
    image: url(Graphics/Icon_Check.svg);
    border: 1px solid #5b7a9e;
}
QCheckBox#chk_show_type_0::indicator:unchecked {
    background-color: #ffffff;
    image: none;
}

/* =========================================================
   Einstellungen Seite (Page_Settings)
   ========================================================= */
#Page_Settings QLabel#lbl_setting_title {
    color: #ECECEC;
    font-size: 22px;
    font-weight: bold;
    padding-bottom: 2px;
}

#Page_Settings #detail_view QLineEdit {
    font-size: 14px;
}

#Page_Settings #detail_view QLineEdit:read-only {
    background-color: #D7A64B;
    color: #000000;
    font-size: 14px;
}

#Page_Settings QTreeView#settings_tree {
    background-color: #181818;
    alternate-background-color: #1e1e1e;
    color: #cccccc;
    border: none;
    border-right: 1px solid #2b2b2b;
    outline: none;
    font-size: 14px;
    padding: 6px 0px;
}

#Page_Settings QTreeView#settings_tree::item {
    height: 38px;
    padding-left: 10px;
    color: #cccccc;
    border: none;
}

#Page_Settings QTreeView#settings_tree::item:hover {
    background-color: #282828;
    color: #ececec;
}

#Page_Settings QTreeView#settings_tree::item:selected,
#Page_Settings QTreeView#settings_tree::item:selected:active,
#Page_Settings QTreeView#settings_tree::item:selected:!active {
    background-color: #304C7A;
    color: #ffffff;
    font-weight: bold;
}

/* Kompakter Icon-Only Button für Durchsuchen */
#Page_Settings QPushButton#btn_browse {
    padding: 0px;
    text-align: center;
}

/* Gefahrenbutton (Starfield-Rot, formatiert wie Tools-Seite) */
QPushButton#btn_danger {
    background-color: #C72138;
    color: #ECECEC;
    border: none;
    border-radius: 2px;
    min-height: 40px;
    padding: 4px 8px;
    text-align: left;
}

QPushButton#btn_danger:hover {
    background-color: #E03048;
}

QPushButton#btn_danger:pressed {
    background-color: #A0182B;
}

QPushButton#btn_danger:disabled, QPushButton[variant="red"]:disabled {
    background-color: #422226;
    color: #888888;
}

/* Grüner Aktionsbutton (Starfield-Grün, z. B. Profil aktivieren) */
QPushButton#btn_success, QPushButton#btn_activate_profile, QPushButton[variant="green"] {
    background-color: #1F7343;
    color: #ECECEC;
    border: none;
    border-radius: 2px;
    padding: 4px 8px;
    text-align: left;
}

QPushButton#btn_success:hover, QPushButton#btn_activate_profile:hover, QPushButton[variant="green"]:hover {
    background-color: #2EA44F;
}

QPushButton#btn_success:pressed, QPushButton#btn_activate_profile:pressed, QPushButton[variant="green"]:pressed {
    background-color: #165A33;
}

QPushButton#btn_success:disabled, QPushButton#btn_activate_profile:disabled, QPushButton[variant="green"]:disabled {
    background-color: #1E5232;
    color: #888888;
}

/* Profilauswahl in Page_LoadOrder mit ergonomischer Zeilenhöhe */
#tree_profile::item {
    height: 26px;
    padding: 0px;
}


