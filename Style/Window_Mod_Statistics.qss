/* =========================================================================
   Starfield LOH – Modulares Stylesheet: Window_Mod_Statistics
   Gekapselte Theme-Regeln fuer das Mod-Statistik- und Analysefenster
   ========================================================================= */

/* Haupt-Container & Scroll-Bereich */
#Window_Mod_Statistics,
#Window_Mod_Statistics QScrollArea,
#Window_Mod_Statistics QWidget#scroll_content {
    background-color: {{ WINDOW_BG }};
}

/* -------------------------------------------------------------------------
   LOH_Control_CollapsibleSection (Klappsektionen)
   ------------------------------------------------------------------------- */
QPushButton#btn_collapsible_header {
    background-color: {{ PANEL_HEADER }};
    border: 1px solid {{ BORDER_SUBTLE }};
    border-left: 4px solid {{ ACCENT_ACTION }};
    border-radius: 2px;
    padding: 0px 8px;
    text-align: left;
}

QPushButton#btn_collapsible_header:hover {
    border-left: 4px solid {{ ACCENT_ACTION_HOVER }};
}

QLabel#lbl_collapsible_title {
    color: {{ COLLAPSIBLE_TITLE }};
    font-family: {{ FONT_FAMILY }};
    font-size: {{ FONT_SIZE_DESC }};
    font-weight: bold;
    background: transparent;
    border: none;
}

/* -------------------------------------------------------------------------
   Section_Mod_Statistics_Comparison (Mod-Vergleich)
   ------------------------------------------------------------------------- */
#Window_Mod_Statistics QFrame#vertical_separator {
    background-color: {{ ACCENT_ACTION }};
    width: 2px;
    max-width: 2px;
    border: none;
}

#Window_Mod_Statistics QLineEdit#inp_comp_name {
    background-color: {{ SURFACE_PRIMARY }};
    color: {{ TEXT_ON_SURFACE }};
    border: 1px solid {{ BORDER_INPUT }};
}

#Window_Mod_Statistics QLabel#lbl_main_image,
#Window_Mod_Statistics QLabel#lbl_comp_image {
    background-color: transparent;
    color: {{ TEXT_MUTED }};
    border: none;
    font-size: {{ FONT_SIZE_SMALL }};
}

#Window_Mod_Statistics QPushButton#btn_select_comp {
    background-color: {{ BUTTON_BLUE_NORMAL }};
    color: {{ BUTTON_TEXT_NORMAL }};
    border: none;
    border-radius: 2px;
    padding: 0px;
    text-align: center;
}

#Window_Mod_Statistics QPushButton#btn_select_comp:hover {
    background-color: {{ BUTTON_BLUE_HOVER }};
}

#Window_Mod_Statistics QPushButton#btn_select_comp:pressed {
    background-color: {{ BUTTON_BLUE_PRESSED }};
}

/* -------------------------------------------------------------------------
   Section_Mod_Statistics_Conflicts (Konflikte)
   ------------------------------------------------------------------------- */
#Window_Mod_Statistics QLabel#lbl_stats {
    color: {{ TEXT_TITLE }};
    font-weight: bold;
    font-size: {{ FONT_SIZE_BUTTON }};
    background: transparent;
    border: none;
}

/* -------------------------------------------------------------------------
   Widget_ClassificationCard & Widget_ConflictCard (Kacheln & Zoom)
   ------------------------------------------------------------------------- */
QFrame#Widget_ClassificationCard,
QFrame#Widget_ConflictCard {
    background-color: {{ SURFACE_CARD }};
    border: 1px solid {{ BORDER_SUBTLE }};
    border-radius: 8px;
}

QFrame#Widget_ClassificationCard:hover,
QFrame#Widget_ConflictCard:hover {
    border: 1px solid {{ ACCENT_ACTION_HOVER }};
}

QFrame#Widget_ClassificationCard[selected="true"],
QFrame#Widget_ConflictCard[selected="true"] {
    border: 2px solid {{ ACCENT_BRAND }};
}

QFrame#Widget_ClassificationCard[zoomed="true"],
QFrame#Widget_ConflictCard[zoomed="true"] {
    border: 2px solid {{ ACCENT_ACTION_HOVER }};
    border-radius: 12px;
}

/* Header-Badge Container */
#Widget_ClassificationCard QFrame#card_badge_frame,
#Widget_ConflictCard QFrame#card_badge_frame {
    border-radius: 3px;
    border: none;
}

#Widget_ClassificationCard[zoomed="true"] QFrame#card_badge_frame,
#Widget_ConflictCard[zoomed="true"] QFrame#card_badge_frame {
    border-radius: 5px;
}

/* Badge Farbstufen */
QFrame#card_badge_frame[badgeColor="critical"] {
    background-color: {{ STATUS_CRITICAL }};
}

QFrame#card_badge_frame[badgeColor="warning"] {
    background-color: {{ STATUS_WARNING }};
}

QFrame#card_badge_frame[badgeColor="brand"] {
    background-color: {{ ACCENT_BRAND }};
}

QFrame#card_badge_frame[badgeColor="muted"] {
    background-color: {{ TEXT_MUTED }};
}

/* Header-Badge Beschriftung */
QLabel#lbl_card_badge {
    font-family: {{ FONT_FAMILY }};
    font-size: {{ FONT_SIZE_SMALL }};
    font-weight: bold;
    background: transparent;
    border: none;
}

#Widget_ClassificationCard[zoomed="true"] QLabel#lbl_card_badge,
#Widget_ConflictCard[zoomed="true"] QLabel#lbl_card_badge {
    font-size: {{ FONT_SIZE_BASE }};
}

QLabel#lbl_card_badge[badgeColor="critical"],
QLabel#lbl_card_badge[badgeColor="warning"] {
    color: #FFFFFF;
}

QLabel#lbl_card_badge[badgeColor="brand"] {
    color: #1E1E1E;
}

QLabel#lbl_card_badge[badgeColor="muted"] {
    color: #CCCCCC;
}

/* Metadaten-Schlüssel (Labels links) */
QLabel#lbl_card_key {
    color: {{ ACCENT_BRAND }};
    font-family: {{ FONT_FAMILY }};
    font-size: {{ FONT_SIZE_SMALL }};
    font-weight: normal;
    background: transparent;
    border: none;
    padding: 0px;
}

QLabel#lbl_card_key[keyRole="winner"] {
    color: {{ STATUS_SUCCESS }};
}

#Widget_ClassificationCard[zoomed="true"] QLabel#lbl_card_key,
#Widget_ConflictCard[zoomed="true"] QLabel#lbl_card_key {
    font-size: {{ FONT_SIZE_BASE }};
}

/* Metadaten-Werte (Rechts) */
QLabel#lbl_card_value {
    color: {{ TEXT_ON_DARK }};
    font-family: {{ FONT_FAMILY }};
    font-size: {{ FONT_SIZE_SMALL }};
    font-weight: normal;
    background: transparent;
    border: none;
    padding: 0px;
}

QLabel#lbl_card_value[isMono="true"] {
    font-family: "Consolas", monospace;
}

#Widget_ClassificationCard[zoomed="true"] QLabel#lbl_card_value,
#Widget_ConflictCard[zoomed="true"] QLabel#lbl_card_value {
    font-size: {{ FONT_SIZE_BASE }};
}

/* Trennbalken (Starfield-Blau) */
#Widget_ClassificationCard QFrame#sep_line,
#Widget_ConflictCard QFrame#sep_line {
    background-color: {{ ACCENT_ACTION }};
    border: none;
    border-radius: 1px;
}

/* Begründungstext */
#Widget_ClassificationCard QLabel#lbl_card_reason,
#Widget_ConflictCard QLabel#lbl_card_reason {
    color: {{ CARD_TEXT_DESC }};
    font-family: {{ FONT_FAMILY }};
    font-size: {{ FONT_SIZE_SMALL }};
    background: transparent;
    border: none;
}

#Widget_ClassificationCard[zoomed="true"] QLabel#lbl_card_reason,
#Widget_ConflictCard[zoomed="true"] QLabel#lbl_card_reason {
    font-size: {{ FONT_SIZE_BASE }};
}

/* Zoom Schließen-Hinweis */
QLabel#lbl_close_hint {
    color: {{ TEXT_MUTED }};
    font-size: {{ FONT_SIZE_SMALL }};
    font-style: italic;
    background: transparent;
    border: none;
}
